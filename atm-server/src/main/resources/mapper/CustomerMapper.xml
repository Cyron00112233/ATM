<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.atm.mapper.CustomerMapper">

    <!-- 公共字段列表，用 <include> 复用 -->
    <sql id="baseColumns">
        id, customer_no, real_name, id_card, phone, gender, address, status, create_time, update_time
    </sql>

    <!-- 查询全部 -->
    <select id="selectAll" resultType="com.atm.entity.Customer">
        select <include refid="baseColumns"/>
        from customer
        order by id
    </select>

    <!-- 按主键查询 -->
    <select id="selectById" resultType="com.atm.entity.Customer">
        select <include refid="baseColumns"/>
        from customer
        where id = #{id}
    </select>

    <!-- 按姓名模糊查询 -->
    <select id="selectByNameLike" resultType="com.atm.entity.Customer">
        select <include refid="baseColumns"/>
        from customer
        where real_name like concat('%', #{name}, '%')
        order by id
    </select>

    <!-- 统计总数 -->
    <select id="count" resultType="long">
        select count(*)
        from customer
    </select>

</mapper>