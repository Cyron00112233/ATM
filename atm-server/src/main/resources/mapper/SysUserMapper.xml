<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.atm.mapper.SysUserMapper">

    <!-- 公共字段（注意：包含 password，因为登录时要拿它做 BCrypt 校验） -->
    <sql id="baseColumns">
        id, username, password, real_name, phone, status, last_login_time, create_time, update_time
    </sql>

    <!-- 按账号查询 -->
    <select id="selectByUsername" resultType="com.atm.entity.SysUser">
        select <include refid="baseColumns"/>
        from sys_user
        where username = #{username}
    </select>

    <!-- 更新最后登录时间 -->
    <update id="updateLastLoginTime">
        update sys_user
        set last_login_time = now()
        where id = #{id}
    </update>

</mapper>